# Šablona pro /etc/vaha/vaha.env na serveru - NEUPRAVOVAT TENTO SOUBOR,
# je jen pro referenci a je součástí gitu (bez skutečných hesel).
#
# Nasazení na serveru (jednorázově):
#   sudo mkdir -p /etc/vaha
#   sudo cp vaha.env.example /etc/vaha/vaha.env
#   sudo nano /etc/vaha/vaha.env        # doplnit skutečné hodnoty
#   sudo chown root:www-data /etc/vaha/vaha.env
#   sudo chmod 640 /etc/vaha/vaha.env
#
# Po vytvoření tohoto souboru už není potřeba hesla duplikovat v
# systemd unitu (Environment=...), crontabu (VAHA_X=Y před příkazem)
# ani v Apache configu (SetEnv) - config.php si je přečte odsud sám,
# ať už skript spouští Apache, systemd, cron nebo ruční příkazová řádka.
# Staré Environment=/SetEnv/crontab řádky lze (ale nemusí) smazat - pokud
# tam zůstanou, mají před tímto souborem přednost.
#
# Povinné (bez výchozí hodnoty, appka bez nich spadne):
VAHA_DB_PASS=
VAHA_ADMIN_PASSWORD=
VAHA_FORCE_SAVE_TOKEN=

# Nepovinné (mají rozumné výchozí hodnoty v config.php, uvést jen při změně):
#VAHA_DB_HOST=localhost
#VAHA_DB_PORT=5432
#VAHA_DB_NAME=vaha
#VAHA_DB_USER=vaha
#VAHA_MEDIAMTX_API=http://127.0.0.1:9997
#VAHA_MEDIAMTX_API_USER=
#VAHA_MEDIAMTX_API_PASS=
#VAHA_PHOTO_STORAGE_PATH=/var/www/vaha/photos/
#VAHA_PHOTO_WEB_PREFIX=photos/
#VAHA_LIVE_WEIGHT_FILE=/var/www/vaha/live_weight.txt
#VAHA_READ_SPZ_SCRIPT=/var/www/vaha/read_spz.py
#VAHA_SCALE_RAW_FILE=/var/www/vaha/scale_raw.txt
#VAHA_SCALE_RELAY_PORT=10002
#VAHA_FORCE_SAVE_FLAG=/var/www/vaha/force_save.flag
